<div class="admin-race-data-round-region" data-race-data-round-region>
  <p class="muted admin-race-data-cutoff" data-race-data-cutoff>
    <%= t('admin_race_data.cutoff') %>: <strong><%= view.selectedRound?.label || '—' %></strong>
    <% if (selectedImport) { %>
      · <%= selectedImport.reconstructed ? t('admin_race_data.reconstructed') : t('admin_race_data.import_status') %>:
      <strong><%= selectedImport.status %></strong>
    <% } %>
  </p>

  <div class="admin-race-data-toolbar">
    <div class="admin-race-data-tabs" role="tablist" aria-label="<%= t('admin_race_data.view_label') %>" data-race-data-view-tabs>
      <a class="admin-race-data-tab <%= viewMode === 'drivers' ? 'is-active' : '' %>"
         href="/admin/race-data?season=<%= season %>&view=drivers&round=<%= view.selectedRoundNumber %>&focus=points"
         role="tab" aria-selected="<%= viewMode === 'drivers' ? 'true' : 'false' %>" data-race-data-view-toggle="drivers">
        <%= t('admin_race_data.drivers_view') %>
      </a>
      <a class="admin-race-data-tab <%= viewMode === 'constructors' ? 'is-active' : '' %>"
         href="/admin/race-data?season=<%= season %>&view=constructors&round=<%= view.selectedRoundNumber %>&focus=points"
         role="tab" aria-selected="<%= viewMode === 'constructors' ? 'true' : 'false' %>" data-race-data-view-toggle="constructors">
        <%= t('admin_race_data.constructors_view') %>
      </a>
    </div>
    <form method="get" action="/admin/race-data" class="admin-race-data-round-form" data-race-data-round-form>
      <input type="hidden" name="view" value="<%= viewMode %>" />
      <input type="hidden" name="season" value="<%= season %>" />
      <input type="hidden" name="focus" value="<%= view.focusId || 'points' %>" />
      <label for="admin-race-data-round"><%= t('admin_race_data.round_label') %></label>
      <select id="admin-race-data-round" name="round">
        <% view.rounds.forEach((round) => { %>
          <option value="<%= round.roundNumber %>" <%= round.roundNumber === view.selectedRoundNumber ? 'selected' : '' %>>
            <%= round.label %>
          </option>
        <% }) %>
      </select>
      <noscript><button type="submit" class="secondary"><%= t('admin_race_data.open_round') %></button></noscript>
    </form>
    <form method="get" action="/admin/race-data" class="admin-race-data-focus-form" data-race-data-focus-form>
      <input type="hidden" name="view" value="<%= viewMode %>" />
      <input type="hidden" name="season" value="<%= season %>" />
      <input type="hidden" name="round" value="<%= view.selectedRoundNumber %>" />
      <label for="admin-race-data-focus"><%= t('admin_race_data.focus_label') %></label>
      <% const visibleFocusOptions = (view.focusOptions || []).filter((option) => option.view === 'all' || option.view === viewMode); %>
      <% const focusGroups = visibleFocusOptions.reduce((groups, option) => {
        const group = option.group || 'other';
        (groups[group] ||= []).push(option);
        return groups;
      }, {}); %>
      <select id="admin-race-data-focus" name="focus">
        <% Object.entries(focusGroups).forEach(([group, options]) => { %>
          <optgroup label="<%= t(`admin_race_data.focus_group_${group}`) %>">
            <% options.forEach((option) => { %>
              <option value="<%= option.id %>" data-race-data-focus-view="<%= option.view %>" <%= option.id === view.focusId ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </optgroup>
        <% }) %>
      </select>
      <noscript><button type="submit" class="secondary"><%= t('admin_race_data.open_focus') %></button></noscript>
    </form>
  </div>

  <% if (view.focusSummary) { %>
    <% const focusSummaryStatusKey = view.focusSummary.status === 'ready'
      ? 'focus_ready'
      : view.focusSummary.status === 'partial'
        ? 'focus_partial'
        : 'focus_unavailable'; %>
    <section class="admin-race-data-focus-summary is-<%= view.focusSummary.status %>" data-race-data-focus-summary aria-label="<%= t('admin_race_data.focus_audit') %>">
      <span class="admin-race-data-focus-summary-label"><%= t('admin_race_data.focus_audit') %></span>
      <strong class="admin-race-data-focus-summary-value" title="<%= view.focusSummary.tooltip || '' %>"><%= view.focusSummary.value %></strong>
      <span class="admin-race-data-focus-summary-detail" title="<%= view.focusSummary.tooltip || '' %>"><%= view.focusSummary.detail %></span>
      <span class="admin-race-data-focus-summary-status"><%= t(`admin_race_data.${focusSummaryStatusKey}`) %></span>
    </section>
  <% } %>

  <div class="admin-race-data-table-wrap">
    <table class="admin-race-data-matrix admin-race-data-matrix--<%= viewMode %>" data-race-data-matrix data-race-data-active-view="<%= viewMode %>">
      <thead>
        <tr>
          <th scope="col" class="admin-race-data-sticky admin-race-data-rank"><%= t('admin_race_data.position') %></th>
          <% if (viewMode === 'drivers') { %>
            <th scope="col" class="admin-race-data-sticky admin-race-data-entity"><%= t('admin_race_data.driver') %></th>
          <% } else { %>
            <th scope="col" class="admin-race-data-sticky admin-race-data-entity"><%= t('admin_race_data.team') %></th>
          <% } %>
          <% view.rounds.forEach((round) => { %>
            <th scope="col" class="admin-race-data-round-head <%= round.afterCutoff ? 'is-after-cutoff' : '' %>">
              <a data-race-data-round-link href="/admin/race-data?season=<%= season %>&view=<%= viewMode %>&round=<%= round.roundNumber %>&focus=<%= view.focusId || 'points' %>">R<%= round.roundNumber %></a>
            </th>
          <% }) %>
          <th scope="col" class="admin-race-data-summary admin-race-data-sticky-right"><%= view.focus?.metricLabel || t('admin_race_data.points') %></th>
        </tr>
      </thead>
      <tbody data-race-data-body="<%= viewMode %>">
        <% if (viewMode === 'drivers') { %>
          <% view.drivers.forEach((row, index) => { %>
            <%- include('admin_race_data_matrix_row', { season, viewMode: 'drivers', detailMode: false, rowKind: 'drivers', row, group: null, groupIndex: 0, groupSize: 1, index, focusId: view.focusId || 'points' }) %>
          <% }) %>
        <% } else { %>
          <% view.constructorGroups.forEach((group) => { %>
            <% group.drivers.forEach((row, groupIndex) => { %>
              <%- include('admin_race_data_matrix_row', { season, viewMode: 'constructors', detailMode: true, rowKind: 'constructor-driver', row, group, groupIndex, groupSize: group.drivers.length, index: groupIndex, focusId: view.focusId || 'points' }) %>
            <% }) %>
          <% }) %>
        <% } %>
      </tbody>
      <%- include('admin_race_data_matrix_footer', { season, viewMode, view }) %>
    </table>
  </div>

  <div class="admin-race-data-legend muted" aria-label="<%= t('admin_race_data.legend') %>">
    <span><strong><%= t('admin_race_data.legend') %>:</strong></span>
    <% if (view.focus?.metric === 'podiums' || view.focus?.metric === 'ferrari_podium') { %>
      <span><%= t('admin_race_data.legend_podium_focus') %></span>
    <% } else if (view.focus?.metric === 'dnfs' || view.focus?.metric === 'dnf_by_race') { %>
      <span><%= t('admin_race_data.legend_dnf_focus') %></span>
    <% } else if (view.focus?.metric === 'grid_wins') { %>
      <span><%= t('admin_race_data.legend_grid_wins_focus') %></span>
    <% } else if (view.focus?.metric === 'driver_of_day') { %>
      <span><%= t('admin_race_data.legend_driver_of_day_focus') %></span>
    <% } else if (view.focus?.metric === 'sprint_points' || view.focus?.metric === 'sprint_champion_same') { %>
      <span><%= t('admin_race_data.legend_sprint_focus') %></span>
    <% } else if (view.focus?.metric === 'qualifying_h2h') { %>
      <span><%= t('admin_race_data.legend_qualifying_focus') %></span>
    <% } else { %>
      <span><%= t('admin_race_data.legend_finish') %></span>
      <span><%= t('admin_race_data.legend_retired') %></span>
      <span><%= t('admin_race_data.legend_dns') %></span>
      <span><%= t('admin_race_data.legend_dnq') %></span>
      <span><%= t('admin_race_data.legend_nc') %></span>
      <span><%= t('admin_race_data.legend_dsq') %></span>
      <span><%= t('admin_race_data.legend_wd') %></span>
      <span><%= t('admin_race_data.legend_pole') %></span>
      <span><%= t('admin_race_data.legend_fastest_lap') %></span>
      <span data-race-data-constructor-legend<%= viewMode === 'constructors' ? '' : ' hidden' %>><%= t('admin_race_data.legend_constructor_podium') %></span>
      <span><%= t('admin_race_data.legend_unavailable') %></span>
    <% } %>
  </div>

  <section class="admin-race-data-detail" aria-labelledby="admin-race-data-detail-heading">
    <div class="admin-race-data-detail-heading">
      <div>
        <h2 id="admin-race-data-detail-heading"><%= view.selectedRound?.label || t('admin_race_data.no_round') %></h2>
        <% if (view.selectedRound?.evidence) { %>
          <p class="muted">
            <%= t('admin_race_data.source_status') %>:
            <strong><%= view.selectedSummary?.status || 'incomplete' %></strong>
            · <%= t('admin_race_data.fetched') %>:
            <%= view.selectedRound.evidence.fetched_at || view.selectedRound.evidence.payload?.fetchedAt || '—' %>
            · <%= view.selectedRound.evidence.source_type || '—' %>
            <% if (view.selectedRound.evidence.reconstructed) { %>
              · <%= t('admin_race_data.reconstructed') %>
            <% } %>
          </p>
          <% if (view.selectedRound.state === 'cancelled') { %>
            <p class="muted"><%= t('admin_race_data.cancelled_round') %></p>
          <% } else if (view.selectedRound.state === 'incomplete') { %>
            <p class="muted"><%= t('admin_race_data.partial_round') %></p>
          <% } %>
        <% } else { %>
          <p class="muted">
            <%= view.selectedRound?.state === 'future'
              ? t('admin_race_data.future_round')
              : view.selectedRound?.state === 'cancelled'
                ? t('admin_race_data.cancelled_round')
                : t('admin_race_data.no_evidence') %>
          </p>
        <% } %>
      </div>
      <% if (selectedSnapshot) { %>
        <a class="secondary button" href="/admin/actuals?season=<%= season %>&target=round:<%= view.selectedRoundNumber %>">
          <%= t('admin_race_data.open_actuals') %>
        </a>
      <% } %>
    </div>

    <% if (view.selectedEvidence) { %>
      <div class="admin-race-data-coverage">
        <% const coverage = view.selectedEvidence.payload?.coverage?.sources || {}; %>
        <span><strong><%= t('admin_race_data.coverage') %>:</strong></span>
        <span>Race <%= coverage.race?.count || 0 %></span>
        <span>Qualifying <%= coverage.qualifying?.count || 0 %></span>
        <span>Sprint <%= coverage.sprint?.count || 0 %></span>
        <span>Driver standings <%= coverage.driverStandings?.count || 0 %></span>
        <span>Constructor standings <%= coverage.constructorStandings?.count || 0 %></span>
      </div>
      <div class="admin-race-data-detail-table-wrap">
        <table class="admin-race-data-detail-table">
          <thead>
            <tr>
              <th><%= t('admin_race_data.driver') %></th>
              <th><%= t('admin_race_data.constructor') %></th>
              <th><%= t('admin_race_data.grid') %></th>
              <th><%= t('admin_race_data.qualifying_short') %></th>
              <th><%= t('admin_race_data.sprint') %></th>
              <th><%= t('admin_race_data.race') %></th>
              <th><%= t('admin_race_data.status') %></th>
              <th><%= t('admin_race_data.points_short') %></th>
            </tr>
          </thead>
          <tbody>
            <% view.detailRows.forEach((row) => { %>
              <tr>
                <th scope="row"><%= row.driver %></th>
                <td><%= row.constructor || '—' %></td>
                <td><%= row.grid == null ? '—' : row.grid %></td>
                <td><%= row.qualifyingPosition == null ? '—' : row.qualifyingPosition %></td>
                <td>
                  <%= row.sprintPosition == null ? '—' : row.sprintPosition %>
                  <% if (row.sprintPoints != null && row.sprintPoints > 0) { %>
                    <small>+<%= row.sprintPoints %></small>
                  <% } %>
                </td>
                <td><%= row.racePosition || row.raceLabel || '—' %></td>
                <td><%= row.raceStatus || row.sprintStatus || '—' %></td>
                <td><%= row.racePoints == null ? '—' : row.racePoints %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (Object.keys(derivedActuals || {}).length > 0) { %>
        <details class="admin-race-data-derived">
          <summary><%= t('admin_race_data.derived_actuals') %> (<%= Object.keys(derivedActuals).length %>)</summary>
          <dl>
            <% Object.entries(derivedActuals).forEach(([questionId, value]) => { %>
              <div><dt><%= questionId %></dt><dd><%= value %></dd></div>
            <% }) %>
          </dl>
        </details>
      <% } %>
    <% } else { %>
      <div class="alert"><%= t('admin_race_data.no_evidence_detail') %></div>
    <% } %>
  </section>
</div>
