<% const inputTabItems = ['drivers', 'teams', 'races', 'scoring'].map((name) => ({
  href: `/admin/inputs?season=${encodeURIComponent(season)}&tab=${name}`,
  label: t('admin_inputs.tab_' + name),
  active: tab === name
})); %>
<% inputTabItems.push({
  href: `/admin/inputs?season=${encodeURIComponent(season)}&tab=definitions`,
  label: 'Definitions',
  active: tab === 'definitions'
}); %>
<% if (Number(unresolvedMappingCount || 0) > 0 || tab === 'mappings') { %>
  <% inputTabItems.push({
    href: `/admin/inputs?season=${encodeURIComponent(season)}&tab=mappings`,
    label: `${t('admin_inputs.data_quality')}${Number(unresolvedMappingCount || 0) > 0 ? ` · ${unresolvedMappingCount}` : ''}`,
    active: tab === 'mappings'
  }); %>
<% } %>
<%- include('admin_segmented_control', {
  ariaLabel: t('admin_inputs.tabs'),
  className: 'admin-inputs-tabs admin-race-data-switch',
  items: inputTabItems
}) %>
