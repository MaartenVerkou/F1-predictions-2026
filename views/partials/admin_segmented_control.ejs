<% const segmentedItems = Array.isArray(items) ? items : []; %>
<% const segmentedClasses = ['admin-segmented-control', className].filter(Boolean).join(' '); %>
<nav class="<%= segmentedClasses %>" aria-label="<%= ariaLabel || '' %>">
  <% segmentedItems.forEach((item) => { %>
    <a
      class="admin-segmented-control__item <%= item.active ? 'is-active' : '' %> <%= item.className || '' %>"
      href="<%= item.href %>"
      <% if (item.title) { %>title="<%= item.title %>"<% } %>
      <% if (item.active) { %>aria-current="page"<% } %>
    ><%= item.label %></a>
  <% }) %>
</nav>
