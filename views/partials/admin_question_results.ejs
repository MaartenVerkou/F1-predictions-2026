<div class="admin-actuals-overview" data-admin-actuals-form>
  <% if (!actualOverviewTargets || actualOverviewTargets.length === 0) { %>
    <div class="admin-empty-state" role="status">
      <strong>No derived results yet.</strong>
      <span class="muted">Review Race Data for this season before publishing question results.</span>
    </div>
  <% } else { %>
    <div class="admin-race-data-table-wrap admin-actuals-overview-wrap">
      <table class="admin-actuals-overview-table">
        <thead>
          <tr>
            <th scope="col" class="admin-actuals-question-column" title="Question">Q</th>
            <% (actualOverviewTargets || []).forEach((target) => { %>
              <th scope="col"
                  class="admin-actuals-round-column <%= target.timing === 'future' ? 'is-future' : '' %>"
                  data-admin-actuals-round="<%= target.roundNumber %>"
                  data-review-status="<%= target.reviewStatus || '' %>">
                <span class="admin-actuals-round-header">
                  <a href="/admin/race-data?season=<%= season %>&round=<%= target.roundNumber %>&view=drivers&focus=points"
                     title="R<%= target.roundNumber %> · <%= target.raceName %>">
                    <span class="admin-actuals-round-name"><%= target.raceCode %></span>
                  </a>
                  <% if (target.reviewStatus === 'pending') { %>
                    <span class="admin-actuals-review-marker"
                          title="<%= t('admin_actuals.needs_review') %>"
                          aria-label="<%= t('admin_actuals.needs_review') %>">!</span>
                  <% } %>
                </span>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% (actualOverviewRows || []).forEach((row) => { %>
            <tr id="question-<%= encodeURIComponent(row.question.id) %>">
              <%- include('admin_actuals_question_cell', { season, row }) %>
              <% row.cells.forEach((cell) => { %>
                <td class="admin-actuals-value-cell <%= cell.timing === 'future' ? 'is-future' : '' %> <%= cell.published ? 'is-published' : '' %>"
                    data-admin-actuals-round="<%= cell.roundNumber %>"
                    data-review-status="<%= cell.reviewStatus || '' %>">
                  <% if (cell.hasValue || cell.reviewStatus) { %>
                    <a href="<%= cell.href %>" title="<%= cell.value %>" aria-label="<%= cell.value %>">
                      <span class="admin-actuals-value"><%= cell.displayText || cell.value %></span>
                    </a>
                  <% } else { %>
                    <span class="muted">—</span>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
