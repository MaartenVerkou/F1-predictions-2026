<%- include('partials/header', { title: t('admin_inputs.title'), user }) %>
<%- include('partials/admin_nav', { active: 'inputs', season }) %>
<% const seasonPreparationField = seasonContext?.status === 'planned' ? '<input type="hidden" name="preparation_confirmed" value="1">' : ''; %>

<div class="card admin-page-card admin-inputs-page">
  <div class="admin-race-data-heading">
    <div>
      <h1><%= t('admin_inputs.title') %></h1>
      <p class="muted admin-page-intro"><%= t('admin_inputs.intro') %></p>
    </div>
    <form method="get" action="/admin/inputs" class="admin-inputs-season-form">
      <label for="admin-inputs-season"><%= t('admin_inputs.season') %></label>
      <select id="admin-inputs-season" name="season" onchange="this.form.submit()">
        <% (availableSeasons || []).forEach((availableSeason) => { %>
          <option value="<%= availableSeason.year %>" <%= Number(availableSeason.year) === Number(season) ? 'selected' : '' %>>
            <%= availableSeason.label %> · <%= availableSeason.statusLabel %>
          </option>
        <% }) %>
      </select>
      <input type="hidden" name="tab" value="<%= tab %>" />
      <input type="hidden" name="round" value="<%= lineupRound %>" />
    </form>
  </div>

  <% if (seasonContext?.invalidRequestedSeason) { %>
    <div class="alert"><%= t('admin_inputs.invalid_season', { season }) %></div>
  <% } else if (!inputsReady) { %>
    <div class="alert"><%= t('admin_inputs.not_seeded') %></div>
  <% } else { %>
    <% if (query?.error) { %><div class="alert"><%= query.error %></div><% } %>
    <% if (query?.success) { %><div class="alert success"><%= query.success %></div><% } %>
    <div class="admin-inputs-summary muted">
      <span><strong><%= catalog.season.label %></strong></span>
      <span><%= catalog.season.status %></span>
      <span><%= t('admin_inputs.driver_count', { count: catalog.drivers.length }) %></span>
      <span><%= t('admin_inputs.team_count', { count: catalog.teams.length }) %></span>
      <span><%= t('admin_inputs.race_count', { count: catalog.races.length }) %></span>
      <span><%= t('admin_inputs.assignment_count', { count: catalog.assignments.length }) %></span>
    </div>
    <p class="muted admin-inputs-impact"><%= t('admin_inputs.impact_summary', { evidence: catalog.impact?.evidenceSnapshots || 0, snapshots: catalog.impact?.actualSnapshots || 0, values: catalog.impact?.actualValues || 0 }) %></p>

    <nav class="admin-inputs-tabs" aria-label="<%= t('admin_inputs.tabs') %>">
      <% ['drivers', 'teams', 'assignments', 'races', 'mappings'].forEach((name) => { %>
        <a class="admin-race-data-tab <%= tab === name ? 'is-active' : '' %>" href="/admin/inputs?season=<%= season %>&tab=<%= name %>&round=<%= lineupRound %>">
          <%= t('admin_inputs.tab_' + name) %>
        </a>
      <% }) %>
    </nav>

    <% if (tab === 'drivers') { %>
      <div class="admin-inputs-table-toolbar" data-table-toolbar="drivers" data-table-capabilities="edit,add,remove">
        <div class="admin-inputs-toolbar-start">
          <button class="secondary" type="button" data-table-edit disabled><%= t('admin_inputs.edit') %></button>
          <button type="button" data-add-driver-row>+ <%= t('admin_inputs.add_driver') %></button>
        </div>
        <div class="admin-inputs-toolbar-end">
          <span class="admin-inputs-selection" data-table-selection aria-live="polite"></span>
          <button class="secondary" type="button" data-table-remove data-remove-confirm="<%= t('admin_inputs.remove_confirm') %>" disabled><%= t('admin_inputs.remove') %></button>
        </div>
      </div>
      <form id="admin-inputs-new-driver-form" method="post" action="/admin/inputs/driver">
        <%- csrfField() %>
        <%- seasonPreparationField %>
        <input type="hidden" name="season" value="<%= season %>">
      </form>
      <form id="admin-inputs-remove-form" method="post" action="/admin/inputs/remove" hidden>
        <%- csrfField() %>
        <%- seasonPreparationField %>
        <input type="hidden" name="season" value="<%= season %>">
        <input type="hidden" name="entity_type" value="">
        <input type="hidden" name="entity_id" value="">
      </form>
      <div class="admin-question-table-wrap admin-table-scroll admin-inputs-data-table-wrap" role="region" aria-label="<%= t('admin_inputs.tab_drivers') %>" tabindex="0">
        <table class="table compact admin-inputs-table" data-selectable-table="drivers">
          <thead><tr><th>#</th><th><%= t('admin_inputs.driver') %></th><th><%= t('admin_inputs.team') %></th><th><%= t('admin_inputs.active') %></th></tr></thead>
          <tbody>
            <% catalog.drivers.forEach((driver) => { %>
              <% const assignment = catalog.assignments.find((item) => Number(item.driver_id) === Number(driver.id) && Number(item.from_round) <= 1 && (item.to_round == null || Number(item.to_round) >= 1)); %>
              <tr data-selectable-row data-edit-target="driver-editor-<%= driver.id %>" data-row-label="<%= driver.display_name_override || driver.display_name %>" tabindex="0"><td><%= driver.driver_number || '—' %></td><th scope="row"><%= driver.display_name_override || driver.display_name %></th><td><%= assignment?.team_name || '—' %></td><td><%= Number(driver.season_active) ? t('admin_inputs.yes') : t('admin_inputs.no') %></td></tr>
              <tr id="driver-editor-<%= driver.id %>" class="admin-inputs-row-editor-row" data-row-editor hidden><td colspan="4"><form method="post" action="/admin/inputs/entity" class="admin-inputs-row-edit-form"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="entity_type" value="driver"><input type="hidden" name="entity_id" value="<%= driver.id %>"><label><%= t('admin_inputs.driver') %><input name="display_name" value="<%= driver.display_name %>" required></label><label><%= t('admin_inputs.driver_number') %><input name="driver_number" type="number" min="1" max="99" value="<%= driver.driver_number || '' %>" required></label><label class="admin-inputs-checkbox-field"><span><%= t('admin_inputs.active') %></span><input name="season_active" type="checkbox" value="1" <%= Number(driver.season_active) ? 'checked' : '' %>></label><button class="secondary" type="submit"><%= t('admin_inputs.save_driver') %></button></form></td></tr>
            <% }) %>
            <tr id="admin-inputs-new-driver-row" class="admin-inputs-new-row" data-new-driver-row hidden><td><label class="sr-only" for="new-driver-number"><%= t('admin_inputs.driver_number') %></label><input id="new-driver-number" name="driver_number" form="admin-inputs-new-driver-form" type="number" min="1" max="99" required></td><th scope="row"><label class="sr-only" for="new-driver-name"><%= t('admin_inputs.driver_name') %></label><input id="new-driver-name" name="display_name" form="admin-inputs-new-driver-form" required></th><td>—</td><td><%= t('admin_inputs.yes') %> <button class="secondary" type="submit" form="admin-inputs-new-driver-form"><%= t('admin_inputs.save') %></button></td></tr>
          </tbody>
        </table>
      </div>
    <% } else if (tab === 'teams') { %>
      <form method="get" action="/admin/inputs" class="admin-inputs-lineup-round-form">
        <input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="tab" value="teams">
        <label for="lineup-round"><%= t('admin_inputs.lineup_round') %></label>
        <select id="lineup-round" name="round" onchange="this.form.submit()"><% catalog.races.forEach((race) => { %><option value="<%= race.round_number %>" <%= Number(race.round_number) === Number(lineupRound) ? 'selected' : '' %>>R<%= race.round_number %> — <%= race.display_name %></option><% }) %></select>
      </form>
      <div class="admin-inputs-table-toolbar" data-table-toolbar="teams" data-table-capabilities="edit,remove,reorder">
        <div class="admin-inputs-toolbar-start">
          <button class="secondary" type="button" data-table-edit disabled><%= t('admin_inputs.edit') %></button>
        </div>
        <div class="admin-inputs-toolbar-end">
          <span class="admin-inputs-selection" data-table-selection aria-live="polite"></span>
          <button class="secondary" type="button" data-table-remove data-remove-confirm="<%= t('admin_inputs.remove_confirm') %>" disabled><%= t('admin_inputs.remove') %></button>
        </div>
      </div>
      <form id="admin-inputs-remove-form" method="post" action="/admin/inputs/remove" hidden>
        <%- csrfField() %>
        <%- seasonPreparationField %>
        <input type="hidden" name="season" value="<%= season %>">
        <input type="hidden" name="entity_type" value="">
        <input type="hidden" name="entity_id" value="">
      </form>
      <form id="admin-inputs-lineup-form" method="post" action="/admin/inputs/lineup" class="admin-inputs-lineup-form">
        <%- csrfField() %>
        <%- seasonPreparationField %>
        <input type="hidden" name="season" value="<%= season %>">
        <input type="hidden" name="round" value="<%= lineupRound %>">
        <% if (lineupReviewState?.requiresConfirmation) { %>
          <div class="alert admin-inputs-history-warning">
            <%= t('admin_inputs.historical_warning') %>
            <label><input type="checkbox" name="historical_correction" value="1"> <%= t('admin_inputs.historical_confirm') %></label>
          </div>
        <% } %>
      </form>
      <div class="admin-question-table-wrap admin-table-scroll admin-inputs-team-table-wrap" role="region" aria-label="<%= t('admin_inputs.tab_teams') %>" tabindex="0">
        <table class="table compact admin-inputs-table admin-inputs-team-table" data-selectable-table="teams">
          <thead><tr><th aria-label="<%= t('admin_inputs.display_order') %>"></th><th><%= t('admin_inputs.team') %></th><th><%= t('admin_inputs.driver_1') %></th><th><%= t('admin_inputs.driver_2') %></th><th><%= t('admin_inputs.active') %></th></tr></thead>
          <tbody>
            <% lineupProjection.forEach((lineupTeam, index) => { %>
              <% const team = catalog.teams.find((item) => Number(item.id) === Number(lineupTeam.teamId)); %>
              <tr data-selectable-row data-edit-target="team-editor-<%= lineupTeam.teamId %>" data-row-label="<%= lineupTeam.teamName %>" tabindex="0">
                <td class="admin-inputs-team-order"><div class="admin-order-buttons"><form method="post" action="/admin/inputs/team-order"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="team_id" value="<%= lineupTeam.teamId %>"><input type="hidden" name="round" value="<%= lineupRound %>"><button type="submit" class="secondary admin-order-btn" name="direction" value="up" <%= index === 0 ? 'disabled' : '' %> title="<%= t('admin_inputs.move_up') %>" aria-label="<%= t('admin_inputs.move_up') %>">&#8593;</button></form><form method="post" action="/admin/inputs/team-order"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="team_id" value="<%= lineupTeam.teamId %>"><input type="hidden" name="round" value="<%= lineupRound %>"><button type="submit" class="secondary admin-order-btn" name="direction" value="down" <%= index === lineupProjection.length - 1 ? 'disabled' : '' %> title="<%= t('admin_inputs.move_down') %>" aria-label="<%= t('admin_inputs.move_down') %>">&#8595;</button></form></div></td>
                <th scope="row"><%= lineupTeam.teamName %></th>
                <% lineupTeam.seats.forEach((seat) => { %>
                  <td>
                    <label class="sr-only" for="team-<%= lineupTeam.teamId %>-seat-<%= seat.seatNumber %>"><%= seat.seatNumber === 1 ? t('admin_inputs.driver_1') : t('admin_inputs.driver_2') %> — <%= lineupTeam.teamName %></label>
                    <select id="team-<%= lineupTeam.teamId %>-seat-<%= seat.seatNumber %>" name="team_<%= lineupTeam.teamId %>_seat_<%= seat.seatNumber %>" form="admin-inputs-lineup-form">
                      <option value=""><%= t('admin_inputs.empty_seat') %></option>
                      <% catalog.drivers.forEach((driver) => { %>
                        <option value="<%= driver.id %>" <%= Number(driver.id) === Number(seat.driverId) ? 'selected' : '' %>><%= driver.display_name_override || driver.display_name %></option>
                      <% }) %>
                    </select>
                  </td>
                <% }) %>
                <td><%= Number(team?.season_active) ? t('admin_inputs.yes') : t('admin_inputs.no') %></td>
              </tr>
              <tr id="team-editor-<%= lineupTeam.teamId %>" class="admin-inputs-row-editor-row" data-row-editor hidden><td colspan="5"><form method="post" action="/admin/inputs/entity" class="admin-inputs-row-edit-form"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="entity_type" value="team"><input type="hidden" name="entity_id" value="<%= lineupTeam.teamId %>"><label><%= t('admin_inputs.team') %><input name="display_name" value="<%= team?.display_name || lineupTeam.teamName %>" required></label><label class="admin-inputs-checkbox-field"><span><%= t('admin_inputs.active') %></span><input name="season_active" type="checkbox" value="1" <%= Number(team?.season_active) ? 'checked' : '' %>></label><button class="secondary" type="submit"><%= t('admin_inputs.save_team') %></button></form></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <button type="submit" form="admin-inputs-lineup-form"><%= t('admin_inputs.save_lineup') %></button>
    <% } else if (tab === 'assignments') { %>
      <div class="admin-inputs-table-toolbar" data-table-toolbar="assignments" data-table-capabilities="read-only">
        <div class="admin-inputs-toolbar-start"><strong><%= t('admin_inputs.lineup_history') %></strong></div>
        <div class="admin-inputs-toolbar-end"><span class="muted"><%= t('admin_inputs.lineup_history_help') %></span></div>
      </div>
      <div class="admin-question-table-wrap admin-table-scroll admin-inputs-data-table-wrap" role="region" aria-label="<%= t('admin_inputs.tab_assignments') %>" tabindex="0">
        <table class="table compact admin-inputs-table" data-selectable-table="assignments">
          <thead><tr><th><%= t('admin_inputs.driver') %></th><th><%= t('admin_inputs.team') %></th><th><%= t('admin_inputs.seat') %></th><th><%= t('admin_inputs.from_round') %></th><th><%= t('admin_inputs.to_round') %></th></tr></thead>
          <tbody><% catalog.assignments.forEach((assignment) => { %><tr data-selectable-row data-row-label="<%= assignment.driver_name %> — <%= assignment.team_name %>" tabindex="0"><th scope="row"><%= assignment.driver_name %></th><td><%= assignment.team_name %></td><td><%= assignment.seat_number || 1 %></td><td>R<%= assignment.from_round %></td><td><%= assignment.to_round == null ? '—' : 'R' + assignment.to_round %></td></tr><% }) %></tbody>
        </table>
      </div>
    <% } else if (tab === 'races') { %>
      <div class="admin-inputs-table-toolbar" data-table-toolbar="races" data-table-capabilities="edit">
        <div class="admin-inputs-toolbar-start">
          <button class="secondary" type="button" data-table-edit disabled><%= t('admin_inputs.edit') %></button>
        </div>
        <div class="admin-inputs-toolbar-end">
          <span class="admin-inputs-selection" data-table-selection aria-live="polite"></span>
        </div>
      </div>
      <div class="admin-question-table-wrap admin-table-scroll admin-inputs-data-table-wrap" role="region" aria-label="<%= t('admin_inputs.tab_races') %>" tabindex="0">
        <table class="table compact admin-inputs-table" data-selectable-table="races">
          <thead><tr><th><%= t('admin_inputs.round') %></th><th><%= t('admin_inputs.race') %></th><th><%= t('admin_inputs.status') %></th></tr></thead>
          <tbody><% catalog.races.forEach((race) => { %><tr data-selectable-row data-edit-target="race-editor-<%= race.id %>" data-row-label="<%= race.display_name %>" tabindex="0"><td>R<%= race.round_number %></td><th scope="row"><%= race.display_name %></th><td><%= race.calendar_state %></td></tr><tr id="race-editor-<%= race.id %>" class="admin-inputs-row-editor-row" data-row-editor hidden><td colspan="3"><form method="post" action="/admin/inputs/entity" class="admin-inputs-row-edit-form"><%- csrfField() %><%- seasonPreparationField %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="entity_type" value="race"><input type="hidden" name="entity_id" value="<%= race.id %>"><label><%= t('admin_inputs.race') %><input name="display_name" value="<%= race.display_name %>" required></label><label><%= t('admin_inputs.status') %><select name="calendar_state"><% ['scheduled','completed','cancelled','partial'].forEach((state) => { %><option value="<%= state %>" <%= race.calendar_state === state ? 'selected' : '' %>><%= state %></option><% }) %></select></label><button class="secondary" type="submit"><%= t('admin_inputs.save_race') %></button></form></td></tr><% }) %></tbody>
        </table>
      </div>
    <% } else { %>
      <% const unresolvedMappings = (catalog.mappings || []).filter((mapping) => mapping.status !== 'resolved'); %>
      <% if (!unresolvedMappings.length) { %>
        <div class="alert"><%= t('admin_inputs.mappings_empty') %></div>
      <% } else { %>
        <div class="admin-inputs-table-toolbar"><strong><%= t('admin_inputs.mapping_queue') %></strong><span class="muted"><%= t('admin_inputs.mapping_queue_help') %></span></div>
        <div class="admin-question-table-wrap admin-table-scroll admin-inputs-data-table-wrap" role="region" aria-label="<%= t('admin_inputs.tab_mappings') %>" tabindex="0">
          <table class="table compact admin-inputs-table">
            <thead><tr><th><%= t('admin_inputs.provider') %></th><th><%= t('admin_inputs.entity_type') %></th><th><%= t('admin_inputs.source_label') %></th><th><%= t('admin_inputs.canonical_candidate') %></th><th><%= t('admin_inputs.status') %></th><th></th></tr></thead>
            <tbody><% unresolvedMappings.forEach((mapping) => { const candidates = mapping.entityType === 'driver' ? catalog.drivers : mapping.entityType === 'team' ? catalog.teams : catalog.races; %><tr><td><%= mapping.provider || mapping.mappingType %></td><td><%= mapping.entityType %></td><td><%= mapping.sourceLabel %></td><td><%= mapping.canonicalName || '—' %></td><td><%= mapping.status %></td><td><form method="post" action="/admin/inputs/mappings/resolve" class="admin-inline-form"><%- csrfField() %><%- seasonPreparationField %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="mapping_type" value="<%= mapping.mappingType %>"><input type="hidden" name="mapping_id" value="<%= mapping.id %>"><input type="hidden" name="entity_type" value="<%= mapping.entityType %>"><select name="entity_id" aria-label="<%= t('admin_inputs.canonical_candidate') %>"><% candidates.forEach((candidate) => { %><option value="<%= candidate.id %>"><%= candidate.display_name_override || candidate.display_name %></option><% }) %></select><button class="secondary" type="submit"><%= t('admin_inputs.resolve') %></button></form></td></tr><% }) %></tbody>
          </table>
        </div>
      <% } %>
    <% } %>
  <% } %>
</div>
