<%- include('partials/header', { title: t('admin_inputs.title'), user }) %>
<%- include('partials/admin_nav', { active: 'inputs' }) %>

<div class="card admin-page-card admin-inputs-page">
  <div class="admin-race-data-heading">
    <div>
      <h1><%= t('admin_inputs.title') %></h1>
      <p class="muted admin-page-intro"><%= t('admin_inputs.intro') %></p>
    </div>
    <form method="get" action="/admin/inputs" class="admin-inputs-season-form">
      <label for="admin-inputs-season"><%= t('admin_inputs.season') %></label>
      <input id="admin-inputs-season" name="season" type="number" min="2000" max="2100" value="<%= season %>" />
      <input type="hidden" name="tab" value="<%= tab %>" />
      <input type="hidden" name="round" value="<%= lineupRound %>" />
      <button class="secondary" type="submit"><%= t('admin_inputs.open') %></button>
    </form>
  </div>

  <% if (!inputsReady) { %>
    <div class="alert"><%= t('admin_inputs.not_seeded') %></div>
  <% } else { %>
    <% if (query?.error) { %><div class="alert"><%= query.error %></div><% } %>
    <% if (query?.success) { %><div class="alert success"><%= query.success %></div><% } %>
    <div class="admin-inputs-summary muted">
      <span><strong><%= catalog.season.label %></strong></span>
      <span><%= t('admin_inputs.driver_count', { count: catalog.drivers.length }) %></span>
      <span><%= t('admin_inputs.team_count', { count: catalog.teams.length }) %></span>
      <span><%= t('admin_inputs.race_count', { count: catalog.races.length }) %></span>
      <span><%= t('admin_inputs.assignment_count', { count: catalog.assignments.length }) %></span>
    </div>
    <p class="muted admin-inputs-impact"><%= t('admin_inputs.impact_summary', { evidence: catalog.impact?.evidenceSnapshots || 0, snapshots: catalog.impact?.actualSnapshots || 0, values: catalog.impact?.actualValues || 0 }) %></p>

    <nav class="admin-inputs-tabs" aria-label="<%= t('admin_inputs.tabs') %>">
      <% ['drivers', 'teams', 'assignments', 'races', 'mappings'].forEach((name) => { %>
        <a class="admin-race-data-tab <%= tab === name ? 'is-active' : '' %>" href="/admin/inputs?season=<%= season %>&tab=<%= name %>&round=<%= lineupRound %>">
          <%= t('admin_inputs.tab_' + name) %>
        </a>
      <% }) %>
    </nav>

    <% if (tab === 'drivers') { %>
      <div class="admin-inputs-table-toolbar" data-table-toolbar="drivers">
        <button class="secondary" type="button" data-table-edit disabled><%= t('admin_inputs.edit') %></button>
        <button type="button" data-add-driver-row>+ <%= t('admin_inputs.add_driver') %></button>
        <span class="admin-inputs-selection" data-table-selection aria-live="polite"></span>
      </div>
      <form id="admin-inputs-new-driver-form" method="post" action="/admin/inputs/driver">
        <%- csrfField() %>
        <input type="hidden" name="season" value="<%= season %>">
      </form>
      <div class="admin-race-data-table-wrap">
        <table class="admin-inputs-table" data-selectable-table="drivers">
          <thead><tr><th>#</th><th><%= t('admin_inputs.driver') %></th><th><%= t('admin_inputs.team') %></th><th><%= t('admin_inputs.active') %></th></tr></thead>
          <tbody>
            <% catalog.drivers.forEach((driver) => { %>
              <% const assignment = catalog.assignments.find((item) => Number(item.driver_id) === Number(driver.id) && Number(item.from_round) <= 1 && (item.to_round == null || Number(item.to_round) >= 1)); %>
              <tr data-selectable-row data-edit-target="driver-editor-<%= driver.id %>" data-row-label="<%= driver.display_name_override || driver.display_name %>" tabindex="0"><td><%= driver.driver_number || '—' %></td><th scope="row"><%= driver.display_name_override || driver.display_name %></th><td><%= assignment?.team_name || '—' %></td><td><%= Number(driver.season_active) ? t('admin_inputs.yes') : t('admin_inputs.no') %></td></tr>
              <tr id="driver-editor-<%= driver.id %>" class="admin-inputs-row-editor-row" data-row-editor hidden><td colspan="4"><form method="post" action="/admin/inputs/entity" class="admin-inputs-row-edit-form"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="entity_type" value="driver"><input type="hidden" name="entity_id" value="<%= driver.id %>"><label><%= t('admin_inputs.driver') %><input name="display_name" value="<%= driver.display_name %>" required></label><label><%= t('admin_inputs.driver_number') %><input name="driver_number" type="number" min="1" max="99" value="<%= driver.driver_number || '' %>" required></label><button class="secondary" type="submit"><%= t('admin_inputs.save_driver') %></button></form></td></tr>
            <% }) %>
            <tr id="admin-inputs-new-driver-row" class="admin-inputs-new-row" data-new-driver-row hidden><td><label class="sr-only" for="new-driver-number"><%= t('admin_inputs.driver_number') %></label><input id="new-driver-number" name="driver_number" form="admin-inputs-new-driver-form" type="number" min="1" max="99" required></td><th scope="row"><label class="sr-only" for="new-driver-name"><%= t('admin_inputs.driver_name') %></label><input id="new-driver-name" name="display_name" form="admin-inputs-new-driver-form" required></th><td>—</td><td><%= t('admin_inputs.yes') %> <button class="secondary" type="submit" form="admin-inputs-new-driver-form"><%= t('admin_inputs.save') %></button></td></tr>
          </tbody>
        </table>
      </div>
    <% } else if (tab === 'teams') { %>
      <form method="get" action="/admin/inputs" class="admin-inputs-lineup-round-form">
        <input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="tab" value="teams">
        <label for="lineup-round"><%= t('admin_inputs.lineup_round') %></label>
        <select id="lineup-round" name="round" onchange="this.form.submit()"><% catalog.races.forEach((race) => { %><option value="<%= race.round_number %>" <%= Number(race.round_number) === Number(lineupRound) ? 'selected' : '' %>>R<%= race.round_number %> — <%= race.display_name %></option><% }) %></select>
      </form>
      <form method="post" action="/admin/inputs/lineup" class="admin-inputs-lineup-form">
        <%- csrfField() %>
        <input type="hidden" name="season" value="<%= season %>">
        <input type="hidden" name="round" value="<%= lineupRound %>">
        <% if (lineupReviewState?.requiresConfirmation) { %>
          <div class="alert admin-inputs-history-warning">
            <%= t('admin_inputs.historical_warning') %>
            <label><input type="checkbox" name="historical_correction" value="1"> <%= t('admin_inputs.historical_confirm') %></label>
          </div>
        <% } %>
        <div class="admin-race-data-table-wrap">
          <table class="admin-inputs-table admin-inputs-lineup-table">
            <thead><tr><th><%= t('admin_inputs.team') %></th><th><%= t('admin_inputs.driver_1') %></th><th><%= t('admin_inputs.driver_2') %></th></tr></thead>
            <tbody>
              <% lineupProjection.forEach((lineupTeam) => { %>
                <tr>
                  <th scope="row"><%= lineupTeam.teamName %></th>
                  <% lineupTeam.seats.forEach((seat) => { %>
                    <td>
                      <label class="sr-only" for="team-<%= lineupTeam.teamId %>-seat-<%= seat.seatNumber %>"><%= seat.seatNumber === 1 ? t('admin_inputs.driver_1') : t('admin_inputs.driver_2') %> — <%= lineupTeam.teamName %></label>
                      <select id="team-<%= lineupTeam.teamId %>-seat-<%= seat.seatNumber %>" name="team_<%= lineupTeam.teamId %>_seat_<%= seat.seatNumber %>">
                        <option value=""><%= t('admin_inputs.empty_seat') %></option>
                        <% catalog.drivers.forEach((driver) => { %>
                          <option value="<%= driver.id %>" <%= Number(driver.id) === Number(seat.driverId) ? 'selected' : '' %>><%= driver.display_name_override || driver.display_name %></option>
                        <% }) %>
                      </select>
                    </td>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <button type="submit"><%= t('admin_inputs.save_lineup') %></button>
      </form>
      <details class="admin-inputs-advanced">
        <summary><%= t('admin_inputs.advanced_team_settings') %></summary>
        <div class="admin-inputs-table-toolbar" data-table-toolbar="teams">
          <button class="secondary" type="button" data-table-edit disabled><%= t('admin_inputs.edit') %></button>
          <span class="admin-inputs-selection" data-table-selection aria-live="polite"></span>
        </div>
        <div class="admin-race-data-table-wrap">
          <table class="admin-inputs-table" data-selectable-table="teams">
            <thead><tr><th><%= t('admin_inputs.team') %></th><th><%= t('admin_inputs.display_order') %></th><th><%= t('admin_inputs.order_basis') %></th></tr></thead>
            <tbody><% catalog.teams.forEach((team) => { %><tr data-selectable-row data-edit-target="team-editor-<%= team.id %>" data-row-label="<%= team.display_name_override || team.display_name %>" tabindex="0"><th scope="row"><%= team.display_name_override || team.display_name %></th><td><%= team.display_order || 0 %></td><td><%= team.order_basis === 'official' ? t('admin_inputs.order_basis_official') : team.order_basis === 'previous_standings' ? t('admin_inputs.order_basis_previous_standings') : t('admin_inputs.order_basis_manual') %></td></tr><tr id="team-editor-<%= team.id %>" class="admin-inputs-row-editor-row" data-row-editor hidden><td colspan="3"><form method="post" action="/admin/inputs/entity" class="admin-inputs-row-edit-form"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="entity_type" value="team"><input type="hidden" name="entity_id" value="<%= team.id %>"><label><%= t('admin_inputs.team') %><input name="display_name" value="<%= team.display_name %>" required></label><label><%= t('admin_inputs.display_order') %><input name="display_order" type="number" min="0" value="<%= team.display_order || 0 %>"></label><label><%= t('admin_inputs.order_basis') %><select name="order_basis"><option value="official" <%= team.order_basis === 'official' ? 'selected' : '' %>><%= t('admin_inputs.order_basis_official') %></option><option value="previous_standings" <%= team.order_basis === 'previous_standings' ? 'selected' : '' %>><%= t('admin_inputs.order_basis_previous_standings') %></option><option value="manual" <%= !team.order_basis || team.order_basis === 'manual' ? 'selected' : '' %>><%= t('admin_inputs.order_basis_manual') %></option></select></label><button class="secondary" type="submit"><%= t('admin_inputs.save_team') %></button></form></td></tr><% }) %></tbody>
          </table>
        </div>
      </details>
    <% } else if (tab === 'assignments') { %>
      <form method="post" action="/admin/inputs/assignment" class="admin-inputs-assignment-form"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><label><%= t('admin_inputs.driver') %><select name="driver_id" required><% catalog.drivers.forEach((driver) => { %><option value="<%= driver.id %>"><%= driver.display_name %></option><% }) %></select></label><label><%= t('admin_inputs.team') %><select name="team_id" required><% catalog.teams.forEach((team) => { %><option value="<%= team.id %>"><%= team.display_name %></option><% }) %></select></label><label><%= t('admin_inputs.seat') %><select name="seat_number"><option value="1"><%= t('admin_inputs.driver_1') %></option><option value="2"><%= t('admin_inputs.driver_2') %></option></select></label><label><%= t('admin_inputs.from_round') %><input name="from_round" type="number" min="1" max="<%= catalog.races.length %>" value="1" required></label><label><%= t('admin_inputs.to_round') %><input name="to_round" type="number" min="1" max="<%= catalog.races.length %>"></label><label><%= t('admin_inputs.source') %><input name="source" value="admin"></label><button type="submit"><%= t('admin_inputs.save_assignment') %></button></form>
      <div class="admin-inputs-table-toolbar" data-table-toolbar="assignments">
        <button class="secondary" type="button" data-table-edit disabled><%= t('admin_inputs.edit') %></button>
        <span class="admin-inputs-selection" data-table-selection aria-live="polite"></span>
      </div>
      <div class="admin-race-data-table-wrap">
        <table class="admin-inputs-table" data-selectable-table="assignments">
          <thead><tr><th><%= t('admin_inputs.driver') %></th><th><%= t('admin_inputs.team') %></th><th><%= t('admin_inputs.seat') %></th><th><%= t('admin_inputs.from_round') %></th><th><%= t('admin_inputs.to_round') %></th><th><%= t('admin_inputs.source') %></th></tr></thead>
          <tbody><% catalog.assignments.forEach((assignment) => { %><tr data-selectable-row data-edit-target="assignment-editor-<%= assignment.id %>" data-row-label="<%= assignment.driver_name %> — <%= assignment.team_name %>" tabindex="0"><th scope="row"><%= assignment.driver_name %></th><td><%= assignment.team_name %></td><td><%= assignment.seat_number || 1 %></td><td>R<%= assignment.from_round %></td><td><%= assignment.to_round == null ? '—' : 'R' + assignment.to_round %></td><td><%= assignment.source %></td></tr><tr id="assignment-editor-<%= assignment.id %>" class="admin-inputs-row-editor-row" data-row-editor hidden><td colspan="6"><form method="post" action="/admin/inputs/assignment" class="admin-inputs-row-edit-form"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="id" value="<%= assignment.id %>"><label><%= t('admin_inputs.driver') %><select name="driver_id" required><% catalog.drivers.forEach((driver) => { %><option value="<%= driver.id %>" <%= Number(driver.id) === Number(assignment.driver_id) ? 'selected' : '' %>><%= driver.display_name_override || driver.display_name %></option><% }) %></select></label><label><%= t('admin_inputs.team') %><select name="team_id" required><% catalog.teams.forEach((team) => { %><option value="<%= team.id %>" <%= Number(team.id) === Number(assignment.team_id) ? 'selected' : '' %>><%= team.display_name_override || team.display_name %></option><% }) %></select></label><label><%= t('admin_inputs.seat') %><select name="seat_number"><option value="1" <%= Number(assignment.seat_number || 1) === 1 ? 'selected' : '' %>><%= t('admin_inputs.driver_1') %></option><option value="2" <%= Number(assignment.seat_number || 1) === 2 ? 'selected' : '' %>><%= t('admin_inputs.driver_2') %></option></select></label><label><%= t('admin_inputs.from_round') %><input name="from_round" type="number" min="1" max="<%= catalog.races.length %>" value="<%= assignment.from_round %>" required></label><label><%= t('admin_inputs.to_round') %><input name="to_round" type="number" min="1" max="<%= catalog.races.length %>" value="<%= assignment.to_round == null ? '' : assignment.to_round %>"></label><label><%= t('admin_inputs.source') %><input name="source" value="<%= assignment.source %>"></label><button class="secondary" type="submit"><%= t('admin_inputs.save_assignment') %></button></form></td></tr><% }) %></tbody>
        </table>
      </div>
    <% } else if (tab === 'races') { %>
      <div class="admin-inputs-table-toolbar" data-table-toolbar="races">
        <button class="secondary" type="button" data-table-edit disabled><%= t('admin_inputs.edit') %></button>
        <span class="admin-inputs-selection" data-table-selection aria-live="polite"></span>
      </div>
      <div class="admin-race-data-table-wrap">
        <table class="admin-inputs-table" data-selectable-table="races">
          <thead><tr><th><%= t('admin_inputs.round') %></th><th><%= t('admin_inputs.race') %></th><th><%= t('admin_inputs.slug') %></th><th><%= t('admin_inputs.status') %></th></tr></thead>
          <tbody><% catalog.races.forEach((race) => { %><tr data-selectable-row data-edit-target="race-editor-<%= race.id %>" data-row-label="<%= race.display_name %>" tabindex="0"><td>R<%= race.round_number %></td><th scope="row"><%= race.display_name %></th><td><%= race.slug %></td><td><%= race.calendar_state %></td></tr><tr id="race-editor-<%= race.id %>" class="admin-inputs-row-editor-row" data-row-editor hidden><td colspan="4"><form method="post" action="/admin/inputs/entity" class="admin-inputs-row-edit-form"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="entity_type" value="race"><input type="hidden" name="entity_id" value="<%= race.id %>"><label><%= t('admin_inputs.race') %><input name="display_name" value="<%= race.display_name %>" required></label><label><%= t('admin_inputs.status') %><select name="calendar_state"><% ['scheduled','completed','cancelled','partial'].forEach((state) => { %><option value="<%= state %>" <%= race.calendar_state === state ? 'selected' : '' %>><%= state %></option><% }) %></select></label><button class="secondary" type="submit"><%= t('admin_inputs.save_race') %></button></form></td></tr><% }) %></tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert"><%= t('admin_inputs.mappings_empty') %></div>
      <form method="post" action="/admin/inputs/alias" class="admin-inputs-assignment-form"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="tab" value="mappings"><label><%= t('admin_inputs.entity_type') %><select name="entity_type"><option value="driver"><%= t('admin_inputs.driver') %></option><option value="team"><%= t('admin_inputs.team') %></option><option value="race"><%= t('admin_inputs.race') %></option></select></label><label><%= t('admin_inputs.entity_id') %><input name="entity_id" type="number" min="1" required></label><label><%= t('admin_inputs.alias') %><input name="alias" required></label><button type="submit"><%= t('admin_inputs.save_alias') %></button></form>
      <form method="post" action="/admin/inputs/provider-ref" class="admin-inputs-assignment-form"><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><label><%= t('admin_inputs.entity_type') %><select name="entity_type"><option value="driver"><%= t('admin_inputs.driver') %></option><option value="team"><%= t('admin_inputs.team') %></option><option value="race"><%= t('admin_inputs.race') %></option></select></label><label><%= t('admin_inputs.entity_id') %><input name="entity_id" type="number" min="1" required></label><label><%= t('admin_inputs.provider') %><input name="provider" value="jolpica" required></label><label><%= t('admin_inputs.provider_key') %><input name="provider_key" required></label><button type="submit"><%= t('admin_inputs.save_provider') %></button></form>
    <% } %>
  <% } %>
</div>
