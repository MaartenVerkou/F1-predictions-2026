<%- include('partials/header', { title: t('admin_inputs.title'), user }) %>
<%- include('partials/admin_nav', { active: 'inputs', season }) %>
<% const seasonPreparationField = seasonContext?.status === 'planned' ? '<input type="hidden" name="preparation_confirmed" value="1">' : ''; %>
<% const formatRaceStart = (race) => {
  if (!race?.scheduled_date) return '—';
  try {
    return new Intl.DateTimeFormat(typeof locale === 'string' ? locale : 'en', {
      day: 'numeric', month: 'short', year: 'numeric',
      hour: '2-digit', minute: '2-digit', hour12: false,
      timeZone: race.scheduled_timezone || 'UTC'
    }).format(new Date(race.scheduled_date));
  } catch {
    return race.scheduled_date;
  }
}; %>
<% const formatRaceOffset = (race) => {
  if (!race?.scheduled_date || !race?.scheduled_timezone) return '';
  try {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: race.scheduled_timezone,
      timeZoneName: 'shortOffset'
    }).formatToParts(new Date(race.scheduled_date));
    const offset = parts.find((part) => part.type === 'timeZoneName')?.value || '';
    return offset === 'GMT' ? 'UTC' : offset.replace(/^GMT/, 'UTC');
  } catch {
    return '';
  }
}; %>

<div class="card admin-page-card admin-inputs-page">
  <div class="admin-race-data-heading">
    <div>
      <h1><%= t('admin_inputs.title') %></h1>
      <p class="muted admin-page-intro"><%= t('admin_inputs.intro') %></p>
    </div>
    <form method="get" action="/admin/inputs" class="admin-inputs-season-form">
      <label for="admin-inputs-season"><%= t('admin_inputs.season') %></label>
      <select id="admin-inputs-season" name="season" onchange="this.form.submit()">
        <% (availableSeasons || []).forEach((availableSeason) => { %>
          <option value="<%= availableSeason.year %>" <%= Number(availableSeason.year) === Number(season) ? 'selected' : '' %>>
            <%= availableSeason.label %>
          </option>
        <% }) %>
      </select>
      <% if (seasonContext?.status === 'archived') { %>
        <span class="admin-season-policy-flat" data-admin-season-policy data-season-status="archived"><%= t('admin_inputs.archived_policy_short') %></span>
      <% } %>
      <input type="hidden" name="tab" value="<%= tab %>" />
    </form>
  </div>

  <dialog class="admin-history-dialog" data-admin-history-dialog aria-labelledby="admin-history-dialog-title">
    <h2 id="admin-history-dialog-title"><%= t('admin_inputs.historical_dialog_title') %></h2>
    <p data-admin-history-dialog-message><%= t('admin_inputs.historical_dialog_help') %></p>
    <div class="admin-history-dialog-actions">
      <button type="button" class="secondary" data-admin-history-cancel><%= t('admin_inputs.cancel') %></button>
      <button type="button" data-admin-history-confirm><%= t('admin_inputs.historical_dialog_confirm') %></button>
    </div>
  </dialog>

  <% if (seasonContext?.invalidRequestedSeason) { %>
    <div class="admin-feedback-context">
      <div class="alert" role="alert"><%= t('admin_inputs.invalid_season', { season }) %></div>
    </div>
  <% } else if (!inputsReady) { %>
    <div class="admin-feedback-context">
      <div class="alert" role="status"><%= t('admin_inputs.not_seeded') %></div>
    </div>
  <% } else { %>
    <% if (query?.error || query?.success) { %>
      <div class="admin-feedback-context">
        <% if (query?.error) { %><div class="alert" role="alert"><%= query.error %></div><% } %>
        <% if (query?.success) { %><div class="alert success" role="status"><%= query.success %></div><% } %>
      </div>
    <% } %>
    <% if (tab === 'drivers') { %>
      <div class="admin-inputs-table-toolbar admin-inputs-view-toolbar" data-table-toolbar="drivers" data-table-capabilities="edit,add,remove">
        <%- include('partials/admin_inputs_tabs', { season, tab, unresolvedMappingCount }) %>
        <div class="admin-inputs-toolbar-end">
          <button type="button" data-add-driver-row>+ <%= t('admin_inputs.add_driver') %></button>
          <button class="secondary" type="button" data-table-edit disabled><%= t('admin_inputs.edit') %></button>
          <button class="secondary" type="button" data-table-remove data-remove-confirm="<%= t('admin_inputs.remove_confirm') %>" disabled><%= t('admin_inputs.remove') %></button>
        </div>
      </div>
      <form id="admin-inputs-new-driver-form" method="post" action="/admin/inputs/driver" data-season-mutation>
        <%- csrfField() %>
        <%- seasonPreparationField %>
        <input type="hidden" name="season" value="<%= season %>">
      </form>
      <form id="admin-inputs-remove-form" method="post" action="/admin/inputs/remove" data-season-mutation hidden>
        <%- csrfField() %>
        <%- seasonPreparationField %>
        <input type="hidden" name="season" value="<%= season %>">
        <input type="hidden" name="entity_type" value="">
        <input type="hidden" name="entity_id" value="">
      </form>
      <div class="admin-question-table-wrap admin-table-scroll admin-inputs-data-table-wrap" role="region" aria-label="<%= t('admin_inputs.tab_drivers') %>" tabindex="0">
        <table class="table compact admin-inputs-table admin-inputs-driver-table" data-selectable-table="drivers">
          <colgroup><col class="admin-inputs-driver-col-number"><col class="admin-inputs-driver-col-name"><col class="admin-inputs-driver-col-code"><col class="admin-inputs-driver-col-nationality"><col class="admin-inputs-driver-col-age"></colgroup>
          <thead><tr><th>#</th><th><%= t('admin_inputs.driver') %></th><th><%= t('admin_inputs.driver_code') %></th><th><%= t('admin_inputs.nationality') %></th><th><%= t('admin_inputs.age') %></th></tr></thead>
          <tbody>
            <% catalog.drivers.forEach((driver) => { %>
              <tr data-selectable-row data-edit-target="driver-editor-<%= driver.id %>" data-row-label="<%= driver.display_name_override || driver.display_name %>" tabindex="0"><td><%= driver.driver_number || '—' %></td><th scope="row"><%= driver.display_name_override || driver.display_name %></th><td><%= driver.driver_code || '—' %></td><td><%= driver.nationality_code || '—' %></td><td><%= driver.age == null ? '—' : driver.age %></td></tr>
              <tr id="driver-editor-<%= driver.id %>" class="admin-inputs-row-editor-row" data-row-editor hidden><td colspan="5"><form method="post" action="/admin/inputs/entity" class="admin-inputs-row-edit-form admin-inputs-driver-details-form" data-season-mutation><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="entity_type" value="driver"><input type="hidden" name="entity_id" value="<%= driver.id %>"><label><%= t('admin_inputs.driver') %><input name="display_name" value="<%= driver.display_name %>" required></label><label><%= t('admin_inputs.driver_number') %><input name="driver_number" type="number" min="1" max="99" value="<%= driver.driver_number || '' %>" required></label><label><%= t('admin_inputs.driver_code') %><input name="driver_code" value="<%= driver.driver_code || '' %>" maxlength="3" pattern="[A-Za-z]{3}" autocomplete="off"></label><label><%= t('admin_inputs.nationality') %><input name="nationality_code" value="<%= driver.nationality_code || '' %>" maxlength="3" pattern="[A-Za-z]{3}" autocomplete="off"></label><label><%= t('admin_inputs.date_of_birth') %><input name="date_of_birth" type="date" value="<%= driver.date_of_birth || '' %>"></label><button class="secondary" type="submit"><%= t('admin_inputs.save_driver') %></button></form></td></tr>
            <% }) %>
            <tr id="admin-inputs-new-driver-row" class="admin-inputs-new-row" data-new-driver-row hidden><td><label class="sr-only" for="new-driver-number"><%= t('admin_inputs.driver_number') %></label><input id="new-driver-number" name="driver_number" form="admin-inputs-new-driver-form" type="number" min="1" max="99" required></td><th scope="row"><label class="sr-only" for="new-driver-name"><%= t('admin_inputs.driver_name') %></label><input id="new-driver-name" name="display_name" form="admin-inputs-new-driver-form" required></th><td><label class="sr-only" for="new-driver-code"><%= t('admin_inputs.driver_code') %></label><input id="new-driver-code" name="driver_code" form="admin-inputs-new-driver-form" maxlength="3" pattern="[A-Za-z]{3}" autocomplete="off"></td><td><label class="sr-only" for="new-driver-nationality"><%= t('admin_inputs.nationality') %></label><input id="new-driver-nationality" name="nationality_code" form="admin-inputs-new-driver-form" maxlength="3" pattern="[A-Za-z]{3}" autocomplete="off"></td><td><label class="sr-only" for="new-driver-date-of-birth"><%= t('admin_inputs.date_of_birth') %></label><input id="new-driver-date-of-birth" name="date_of_birth" form="admin-inputs-new-driver-form" type="date"><button class="secondary" type="submit" form="admin-inputs-new-driver-form"><%= t('admin_inputs.save') %></button></td></tr>
          </tbody>
        </table>
      </div>
    <% } else if (tab === 'teams') { %>
      <div class="admin-inputs-table-toolbar admin-inputs-view-toolbar" data-table-toolbar="teams" data-table-capabilities="edit,remove,reorder">
        <%- include('partials/admin_inputs_tabs', { season, tab, unresolvedMappingCount }) %>
        <div class="admin-inputs-toolbar-end">
          <button class="secondary" type="button" data-table-edit disabled><%= t('admin_inputs.edit') %></button>
          <button class="secondary" type="button" data-table-remove data-remove-confirm="<%= t('admin_inputs.remove_confirm') %>" disabled><%= t('admin_inputs.remove') %></button>
        </div>
      </div>
      <form id="admin-inputs-remove-form" method="post" action="/admin/inputs/remove" data-season-mutation hidden>
        <%- csrfField() %>
        <%- seasonPreparationField %>
        <input type="hidden" name="season" value="<%= season %>">
        <input type="hidden" name="entity_type" value="">
        <input type="hidden" name="entity_id" value="">
      </form>
      <div class="admin-question-table-wrap admin-table-scroll admin-inputs-team-table-wrap" role="region" aria-label="<%= t('admin_inputs.tab_teams') %>" tabindex="0">
        <table class="table compact admin-inputs-table admin-inputs-team-table" data-selectable-table="teams">
          <colgroup><col class="admin-inputs-team-col-order"><col class="admin-inputs-team-col-name"><col class="admin-inputs-team-col-driver"><col class="admin-inputs-team-col-driver"></colgroup>
          <thead><tr><th aria-label="<%= t('admin_inputs.display_order') %>"></th><th><%= t('admin_inputs.team') %></th><th><%= t('admin_inputs.driver_1') %></th><th><%= t('admin_inputs.driver_2') %></th></tr></thead>
          <tbody>
            <% teamLineupHistory.forEach((lineupTeam, index) => { %>
              <% const team = catalog.teams.find((item) => Number(item.id) === Number(lineupTeam.teamId)); %>
              <tr data-selectable-row data-edit-target="team-editor-<%= lineupTeam.teamId %>" data-row-label="<%= lineupTeam.teamName %>" tabindex="0">
                <td class="admin-inputs-team-order"><div class="admin-order-buttons"><form method="post" action="/admin/inputs/team-order" data-season-mutation><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="team_id" value="<%= lineupTeam.teamId %>"><button type="submit" class="secondary admin-order-btn" name="direction" value="up" <%= index === 0 ? 'disabled' : '' %> title="<%= t('admin_inputs.move_up') %>" aria-label="<%= t('admin_inputs.move_up') %>">&#8593;</button></form><form method="post" action="/admin/inputs/team-order" data-season-mutation><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="team_id" value="<%= lineupTeam.teamId %>"><button type="submit" class="secondary admin-order-btn" name="direction" value="down" <%= index === teamLineupHistory.length - 1 ? 'disabled' : '' %> title="<%= t('admin_inputs.move_down') %>" aria-label="<%= t('admin_inputs.move_down') %>">&#8595;</button></form></div></td>
                <th scope="row"><div><%= lineupTeam.teamName %></div><% if (team && (team.team_code || team.base_country_code || team.f1_entry_year || team.power_unit)) { %><small class="admin-inputs-entity-meta"><%= [team.team_code, team.base_country_code, team.f1_entry_year ? t('admin_inputs.f1_since_short', { year: team.f1_entry_year }) : null, team.power_unit ? t('admin_inputs.power_unit_short', { value: team.power_unit }) : null].filter(Boolean).join(' · ') %></small><% } %></th>
                <% [1, 2].forEach((seatNumber) => { const periods = lineupTeam.seats[seatNumber] || []; %>
                  <td class="admin-inputs-lineup-history-cell">
                    <% if (!periods.length) { %><span class="muted"><%= t('admin_inputs.lineup_period_empty') %></span><% } %>
                    <% periods.forEach((period) => { %>
                      <div class="admin-lineup-period"><strong><%= period.driverName || t('admin_inputs.lineup_period_empty') %></strong><span>R<%= period.fromRound %>–<%= period.toRound == null ? t('admin_inputs.present') : 'R' + period.toRound %></span></div>
                    <% }) %>
                  </td>
                <% }) %>
              </tr>
              <tr id="team-editor-<%= lineupTeam.teamId %>" class="admin-inputs-row-editor-row" data-row-editor hidden><td colspan="4">
                <div class="admin-inputs-team-editor">
                  <form method="post" action="/admin/inputs/entity" class="admin-inputs-row-edit-form admin-inputs-team-details-form" data-season-mutation><%- csrfField() %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="entity_type" value="team"><input type="hidden" name="entity_id" value="<%= lineupTeam.teamId %>"><label><%= t('admin_inputs.team') %><input name="display_name" value="<%= team?.display_name || lineupTeam.teamName %>" required></label><label><%= t('admin_inputs.team_code') %><input name="team_code" value="<%= team?.team_code || '' %>" maxlength="3" pattern="[A-Za-z]{3}"></label><label><%= t('admin_inputs.base_country') %><input name="base_country_code" value="<%= team?.base_country_code || '' %>" maxlength="2" pattern="[A-Za-z]{2}"></label><label><%= t('admin_inputs.f1_since') %><input name="f1_entry_year" type="number" min="1950" max="2200" value="<%= team?.f1_entry_year || '' %>"></label><label><%= t('admin_inputs.power_unit') %><input name="power_unit" value="<%= team?.power_unit || '' %>" autocomplete="off"></label><button class="secondary" type="submit"><%= t('admin_inputs.save_team') %></button></form>
                  <form method="post" action="/admin/inputs/team-history" class="admin-inputs-lineup-history-form" data-lineup-history-form data-season-mutation data-lineup-remove-confirm="<%= t('admin_inputs.remove_period_confirm') %>">
                    <%- csrfField() %><%- seasonPreparationField %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="team_id" value="<%= lineupTeam.teamId %>">
                    <div class="admin-inputs-lineup-seats">
                      <% [1, 2].forEach((seatNumber) => { const periods = lineupTeam.seats[seatNumber] || []; %>
                        <fieldset class="admin-inputs-lineup-seat" data-lineup-period-list data-seat-number="<%= seatNumber %>">
                          <legend><%= seatNumber === 1 ? t('admin_inputs.driver_1') : t('admin_inputs.driver_2') %></legend>
                          <div data-lineup-period-rows>
                            <% periods.forEach((period) => { %>
                              <div class="admin-lineup-period-editor" data-lineup-period-row>
                                <input type="hidden" name="seat_<%= seatNumber %>_assignment_id[]" value="<%= period.id %>">
                                <label><span class="sr-only"><%= t('admin_inputs.driver') %></span><select name="seat_<%= seatNumber %>_driver_id[]" required><% catalog.drivers.forEach((driver) => { %><option value="<%= driver.id %>" <%= Number(driver.id) === Number(period.driverId) ? 'selected' : '' %>><%= driver.display_name_override || driver.display_name %></option><% }) %></select></label>
                                <label><span><%= t('admin_inputs.from_round') %></span><input name="seat_<%= seatNumber %>_from_round[]" type="number" min="1" max="<%= catalog.races.length %>" value="<%= period.fromRound %>" required></label>
                                <label><span><%= t('admin_inputs.to_round') %></span><input name="seat_<%= seatNumber %>_to_round[]" type="number" min="1" max="<%= catalog.races.length %>" value="<%= period.toRound == null ? '' : period.toRound %>"></label>
                                <button type="button" class="secondary admin-lineup-period-remove" data-lineup-remove-period title="<%= t('admin_inputs.remove_period') %>" aria-label="<%= t('admin_inputs.remove_period') %>">×</button>
                              </div>
                            <% }) %>
                          </div>
                          <button type="button" class="secondary admin-lineup-period-add" data-lineup-add-period>+ <%= t('admin_inputs.add_period') %></button>
                          <template data-lineup-period-template>
                            <div class="admin-lineup-period-editor" data-lineup-period-row>
                              <input type="hidden" name="seat_<%= seatNumber %>_assignment_id[]" value="">
                              <label><span class="sr-only"><%= t('admin_inputs.driver') %></span><select name="seat_<%= seatNumber %>_driver_id[]" required><% catalog.drivers.forEach((driver) => { %><option value="<%= driver.id %>"><%= driver.display_name_override || driver.display_name %></option><% }) %></select></label>
                              <label><span><%= t('admin_inputs.from_round') %></span><input name="seat_<%= seatNumber %>_from_round[]" type="number" min="1" max="<%= catalog.races.length %>" required></label>
                              <label><span><%= t('admin_inputs.to_round') %></span><input name="seat_<%= seatNumber %>_to_round[]" type="number" min="1" max="<%= catalog.races.length %>"></label>
                              <button type="button" class="secondary admin-lineup-period-remove" data-lineup-remove-period title="<%= t('admin_inputs.remove_period') %>" aria-label="<%= t('admin_inputs.remove_period') %>">×</button>
                            </div>
                          </template>
                        </fieldset>
                      <% }) %>
                    </div>
                    <div class="admin-inputs-lineup-history-actions">
                      <span class="admin-inputs-lineup-history-status muted" data-lineup-history-status hidden role="status" aria-live="polite"><%= t('admin_inputs.lineup_changes_pending') %></span>
                      <button type="submit"><%= t('admin_inputs.save_lineup') %></button>
                      <% if (Number(catalog.impact?.evidenceSnapshots || 0) > 0 || Number(catalog.impact?.actualSnapshots || 0) > 0) { %>
                        <label class="admin-inputs-history-confirm"><input type="checkbox" name="historical_correction" value="1"> <span><%= t('admin_inputs.historical_confirm') %></span></label>
                        <span class="muted"><%= t('admin_inputs.historical_warning_short') %></span>
                      <% } %>
                    </div>
                  </form>
                </div>
              </td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else if (tab === 'races') { %>
      <div class="admin-inputs-table-toolbar admin-inputs-view-toolbar" data-table-toolbar="races" data-table-capabilities="edit">
        <%- include('partials/admin_inputs_tabs', { season, tab, unresolvedMappingCount }) %>
        <div class="admin-inputs-toolbar-end">
          <button class="secondary" type="button" data-table-edit disabled><%= t('admin_inputs.edit') %></button>
        </div>
      </div>
      <div class="admin-question-table-wrap admin-table-scroll admin-inputs-data-table-wrap" role="region" aria-label="<%= t('admin_inputs.tab_races') %>" tabindex="0">
        <table class="table compact admin-inputs-table" data-selectable-table="races">
          <thead><tr><th><%= t('admin_inputs.round') %></th><th><%= t('admin_inputs.race') %></th><th><%= t('admin_inputs.race_start') %></th><th><%= t('admin_inputs.live_status') %></th></tr></thead>
              <tbody><% catalog.races.forEach((race) => { %><tr data-selectable-row data-edit-target="race-editor-<%= race.id %>" data-row-label="<%= race.display_name %>" tabindex="0"><td>R<%= race.round_number %></td><th scope="row"><div><%= race.display_name %></div><% if (race.race_code || race.circuit_name) { %><small class="admin-inputs-entity-meta"><%= [race.race_code, race.circuit_name].filter(Boolean).join(' · ') %></small><% } %></th><td class="admin-inputs-race-start"><time datetime="<%= race.scheduled_date || '' %>" title="<%= race.scheduled_timezone || '' %>"><%= formatRaceStart(race) %></time><% const raceOffset = formatRaceOffset(race); if (raceOffset) { %><small class="admin-inputs-entity-meta">(<%= raceOffset %>)</small><% } %></td><td><%= t('admin_inputs.race_status_' + race.derived_status) %></td></tr><tr id="race-editor-<%= race.id %>" class="admin-inputs-row-editor-row" data-row-editor hidden><td colspan="4"><form method="post" action="/admin/inputs/entity" class="admin-inputs-row-edit-form" data-season-mutation><%- csrfField() %><%- seasonPreparationField %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="entity_type" value="race"><input type="hidden" name="entity_id" value="<%= race.id %>"><label><%= t('admin_inputs.race') %><input name="display_name" value="<%= race.display_name %>" required></label><label><%= t('admin_inputs.race_code') %><input name="race_code" value="<%= race.race_code || '' %>" maxlength="8" pattern="[A-Za-z0-9]{2,8}"></label><label><%= t('admin_inputs.country') %><input name="country_code" value="<%= race.country_code || '' %>" maxlength="3" pattern="[A-Za-z]{3}"></label><label><%= t('admin_inputs.circuit') %><input name="circuit_name" value="<%= race.circuit_name || '' %>"></label><label><%= t('admin_inputs.calendar_state') %><select name="calendar_state"><% ['scheduled','completed','cancelled','partial'].forEach((state) => { %><option value="<%= state %>" <%= race.calendar_state === state ? 'selected' : '' %>><%= t('admin_inputs.calendar_state_' + state) %></option><% }) %></select></label><button class="secondary" type="submit"><%= t('admin_inputs.save_race') %></button></form></td></tr><% }) %></tbody>
        </table>
      </div>
    <% } else { %>
      <%- include('partials/admin_inputs_tabs', { season, tab, unresolvedMappingCount }) %>
      <% const unresolvedMappings = (catalog.mappings || []).filter((mapping) => mapping.status !== 'resolved'); %>
      <% if (!unresolvedMappings.length) { %>
        <div class="alert"><%= t('admin_inputs.mappings_empty') %></div>
      <% } else { %>
        <div class="admin-inputs-table-toolbar"><strong><%= t('admin_inputs.mapping_queue') %></strong><span class="muted"><%= t('admin_inputs.mapping_queue_help') %></span></div>
        <div class="admin-question-table-wrap admin-table-scroll admin-inputs-data-table-wrap" role="region" aria-label="<%= t('admin_inputs.tab_mappings') %>" tabindex="0">
          <table class="table compact admin-inputs-table">
            <thead><tr><th><%= t('admin_inputs.provider') %></th><th><%= t('admin_inputs.entity_type') %></th><th><%= t('admin_inputs.source_label') %></th><th><%= t('admin_inputs.canonical_candidate') %></th><th><%= t('admin_inputs.status') %></th><th></th></tr></thead>
                <tbody><% unresolvedMappings.forEach((mapping) => { const candidates = mapping.entityType === 'driver' ? catalog.drivers : mapping.entityType === 'team' ? catalog.teams : catalog.races; %><tr><td><%= mapping.provider || mapping.mappingType %></td><td><%= mapping.entityType %></td><td><%= mapping.sourceLabel %></td><td><%= mapping.canonicalName || '—' %></td><td><%= mapping.status %></td><td><form method="post" action="/admin/inputs/mappings/resolve" class="admin-inline-form" data-season-mutation><%- csrfField() %><%- seasonPreparationField %><input type="hidden" name="season" value="<%= season %>"><input type="hidden" name="mapping_type" value="<%= mapping.mappingType %>"><input type="hidden" name="mapping_id" value="<%= mapping.id %>"><input type="hidden" name="entity_type" value="<%= mapping.entityType %>"><select name="entity_id" aria-label="<%= t('admin_inputs.canonical_candidate') %>"><% candidates.forEach((candidate) => { %><option value="<%= candidate.id %>"><%= candidate.display_name_override || candidate.display_name %></option><% }) %></select><button class="secondary" type="submit"><%= t('admin_inputs.resolve') %></button></form></td></tr><% }) %></tbody>
          </table>
        </div>
      <% } %>
    <% } %>
  <% } %>
</div>
