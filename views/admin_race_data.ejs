<%- include('partials/header', { title: t('admin_race_data.page_title'), user }) %>
<%- include('partials/admin_nav', { active: 'race-data', season }) %>

<div class="card admin-page-card admin-race-data-page">
  <div class="admin-race-data-heading">
    <div>
      <h1><%= t('admin_race_data.heading') %></h1>
      <p class="muted admin-page-intro"><%= t('admin_race_data.intro') %></p>
    </div>
    <div class="admin-race-data-selector-stack" aria-label="Race data selection">
      <form method="get" action="/admin/race-data" class="admin-race-data-selector-form admin-inputs-season-form">
        <label for="admin-race-data-season"><%= t('admin_inputs.season') %></label>
        <select id="admin-race-data-season" name="season" onchange="this.form.submit()">
          <% (availableSeasons || []).forEach((availableSeason) => { %>
            <option value="<%= availableSeason.year %>" <%= Number(availableSeason.year) === Number(season) ? 'selected' : '' %>><%= availableSeason.label %></option>
          <% }) %>
        </select>
        <input type="hidden" name="view" value="<%= viewMode %>" />
        <% if (view.hasSelectedRound) { %><input type="hidden" name="round" value="<%= view.selectedRoundNumber %>" /><% } %>
        <input type="hidden" name="focus" value="<%= view.focusId || 'points' %>" />
      </form>
      <form method="get" action="/admin/race-data" class="admin-race-data-selector-form admin-race-data-round-form" data-race-data-round-form>
        <label for="admin-race-data-round"><%= t('admin_race_data.round_short_label') %></label>
        <select id="admin-race-data-round" name="round" onchange="this.form.submit()">
          <option value="" <%= view.hasSelectedRound ? '' : 'selected' %>><%= t('admin_race_data.season_overview') %></option>
          <% view.rounds.forEach((round) => { %>
            <option value="<%= round.roundNumber %>" <%= view.hasSelectedRound && round.roundNumber === view.selectedRoundNumber ? 'selected' : '' %>><%= round.label %></option>
          <% }) %>
        </select>
        <input type="hidden" name="season" value="<%= season %>" />
        <input type="hidden" name="view" value="<%= viewMode %>" />
        <input type="hidden" name="focus" value="<%= view.focusId || 'points' %>" />
      </form>
    </div>
  </div>

  <% if (seasonContext?.invalidRequestedSeason) { %>
    <div class="admin-feedback-context">
      <div class="alert" role="alert"><%= t('admin_inputs.invalid_season', { season }) %></div>
    </div>
  <% } %>

  <% if (raceDataError || raceDataSuccess) { %>
    <div class="admin-feedback-context admin-race-data-feedback" role="status">
      <div class="<%= raceDataError ? 'alert' : 'notice' %>"><%= raceDataError || raceDataSuccess %></div>
    </div>
  <% } %>

  <%- include('partials/admin_race_data_round_region') %>
</div>
