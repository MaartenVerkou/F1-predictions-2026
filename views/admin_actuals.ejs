<%- include('partials/header', { title: t('admin_actuals.page_title'), user }) %>
<%- include('partials/admin_nav', { active: 'actuals', season }) %>

<div class="card admin-page-card admin-race-data-page admin-actuals-page">
  <div class="admin-race-data-heading">
    <div>
      <h1><%= t('admin_actuals.heading') %></h1>
      <p class="muted admin-page-intro"><%= t('admin_actuals.intro') %></p>
    </div>
    <div class="admin-race-data-selector-stack">
      <form method="get" action="/admin/actuals" class="admin-race-data-selector-form admin-actuals-season-form" data-admin-actuals-season-form>
        <label for="admin-actuals-season"><%= t('admin_inputs.season') %></label>
        <select id="admin-actuals-season" name="season" onchange="this.form.submit()">
          <% (availableSeasons || []).forEach((availableSeason) => { %>
            <option value="<%= availableSeason.year %>" <%= Number(availableSeason.year) === Number(season) ? 'selected' : '' %>><%= availableSeason.label %> · <%= availableSeason.statusLabel %></option>
          <% }) %>
        </select>
      </form>
    </div>
  </div>

  <% if (seasonContext?.invalidRequestedSeason) { %>
    <div class="admin-feedback-context">
      <div class="alert" role="alert"><%= t('admin_inputs.invalid_season', { season }) %></div>
    </div>
  <% } %>

  <% if (saveError || saveSuccess) { %>
    <div class="admin-feedback-context">
      <% if (saveError) { %><div class="alert" role="alert"><%= saveError %></div><% } %>
      <% if (saveSuccess) { %><div class="alert admin-success" role="status"><%= saveSuccess %></div><% } %>
    </div>
  <% } %>

  <div class="admin-actuals-overview" data-admin-actuals-form>
    <div class="admin-race-data-table-wrap admin-actuals-overview-wrap">
      <table class="admin-actuals-overview-table">
        <thead>
          <tr>
            <th scope="col" class="admin-actuals-question-column">Question</th>
            <% (actualOverviewTargets || []).forEach((target) => { %>
              <% const statusLabel = target.reviewStatus === 'pending'
                ? t('admin_actuals.needs_review')
                : target.reviewStatus === 'reviewed'
                  ? t('admin_actuals.reviewed')
                  : target.timing === 'future'
                    ? t('admin_actuals.timing_future')
                    : '—'; %>
              <th scope="col"
                  class="admin-actuals-round-column <%= target.timing === 'future' ? 'is-future' : '' %> <%= target.reviewStatus === 'pending' ? 'is-pending' : '' %>"
                  data-admin-actuals-round="<%= target.roundNumber %>"
                  data-review-status="<%= target.reviewStatus || '' %>">
                <a href="/admin/race-data?season=<%= season %>&round=<%= target.roundNumber %>&view=drivers&focus=points"
                   title="R<%= target.roundNumber %> · <%= target.raceName %>">
                  <span class="admin-actuals-round-name"><%= target.raceCode %></span>
                </a>
                <small title="<%= statusLabel %>"><%= statusLabel %></small>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% (actualOverviewRows || []).forEach((row) => { %>
            <tr>
              <th scope="row" class="admin-actuals-question-cell">
                <span class="admin-actuals-question-content">
                  <span class="admin-actuals-question-number"><%= String(row.questionNumber).padStart(2, '0') %></span>
                  <span class="admin-actuals-question-prompt" title="<%= row.question.prompt %>" aria-label="<%= row.question.prompt %>">
                    <span class="admin-actuals-question-prompt-full"><%= row.question.prompt %></span>
                    <span class="admin-actuals-question-prompt-short" aria-hidden="true"><%= row.shortPrompt %></span>
                  </span>
                  <a class="admin-actuals-question-view-link"
                     href="/admin/race-data?season=<%= encodeURIComponent(season) %>&view=<%= encodeURIComponent(row.baseView) %>&focus=<%= encodeURIComponent(row.question.id) %>"
                     title="<%= row.baseView === 'constructors' ? t('admin_race_data.constructors_view') : t('admin_race_data.drivers_view') %> · <%= row.focusLabel %>">
                    <%= row.baseView === 'constructors' ? t('admin_race_data.constructors_view') : t('admin_race_data.drivers_view') %> · <%= row.focusLabel %>
                  </a>
                </span>
              </th>
              <% row.cells.forEach((cell) => { %>
                <td class="admin-actuals-value-cell <%= cell.timing === 'future' ? 'is-future' : '' %> <%= cell.reviewStatus === 'pending' ? 'is-pending' : '' %> <%= cell.published ? 'is-published' : '' %>"
                    data-admin-actuals-round="<%= cell.roundNumber %>"
                  data-review-status="<%= cell.reviewStatus || '' %>">
                  <% if (cell.hasValue || cell.reviewStatus) { %>
                    <a href="<%= cell.href %>" title="<%= cell.value %>" aria-label="<%= cell.value %>">
                      <span class="admin-actuals-value"><%= cell.displayText || cell.value %></span>
                    </a>
                  <% } else { %>
                    <span class="muted">—</span>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
