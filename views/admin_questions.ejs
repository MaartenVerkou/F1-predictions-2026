<%- include('partials/header', { title: 'Questions', user }) %>
<%- include('partials/admin_nav', { active: 'questions' }) %>

<% const rows = Array.isArray(questionRows) ? questionRows : []; %>
<% const editing = mode === 'edit'; %>

<div class="card admin-page-card admin-questions-page">
  <div class="admin-race-data-heading admin-questions-heading">
    <div>
      <h1>Questions</h1>
      <p class="muted admin-page-intro">
        Manage question wording, order, scoring and inclusion. Stable question IDs keep answers and derivations connected.
      </p>
    </div>
  </div>

  <% if (saveError || saveSuccess) { %>
    <div class="admin-feedback-context">
      <% if (saveError) { %><div class="alert" role="alert"><%= saveError %></div><% } %>
      <% if (saveSuccess) { %><p class="muted" role="status"><%= saveSuccess %></p><% } %>
    </div>
  <% } %>

  <div class="admin-question-table-toolbar admin-race-data-detail-toolbar">
    <div class="admin-race-data-section-heading">
      <h2>Question inputs</h2>
      <span class="muted admin-question-table-help">Wording, order, scoring and inclusion</span>
    </div>
    <div class="admin-race-data-detail-actions admin-toolbar-actions admin-question-actions">
      <% if (editing) { %>
        <button type="submit" form="admin-question-edit-form" class="secondary admin-question-save-button">Save changes</button>
        <a class="button-link secondary admin-question-cancel" href="/admin/questions">Cancel</a>
      <% } else { %>
        <a class="button-link secondary admin-race-data-edit-button admin-question-edit-button" href="/admin/questions?mode=edit">Edit data</a>
      <% } %>
    </div>
  </div>

  <form id="admin-question-edit-form" method="post" action="/admin/questions" class="admin-question-edit-form">
    <%- csrfField() %>
    <div class="admin-question-table-wrap admin-table-scroll" role="region" aria-label="Questions input table" tabindex="0">
      <table class="table compact admin-question-table <%= editing ? 'admin-question-table--editing' : '' %>">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Question</th>
            <th scope="col">Calculation</th>
            <th scope="col">Points</th>
            <th scope="col">Included</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((row) => { %>
            <tr>
              <td class="admin-question-order-number">
                <% if (editing) { %>
                  <label class="sr-only" for="question-<%= row.id %>-order">Order for <%= row.prompt %></label>
                  <input id="question-<%= row.id %>-order" class="admin-question-order-input" type="number" name="<%= row.id %>__order" value="<%= row.number %>" min="1" max="<%= rows.length %>" required>
                <% } else { %>
                  <%= String(row.number).padStart(2, '0') %>
                <% } %>
              </td>
              <td class="admin-question-cell">
                <% if (editing) { %>
                  <label class="sr-only" for="question-<%= row.id %>-prompt">Question wording for <%= row.prompt %></label>
                  <textarea id="question-<%= row.id %>-prompt" name="<%= row.id %>__prompt" rows="2" maxlength="500" required><%= row.prompt %></textarea>
                <% } else { %>
                  <div class="admin-question-title" title="<%= row.prompt %>"><%= row.prompt %></div>
                <% } %>
                <div class="muted admin-question-id"><code class="admin-question-code"><%= row.id %></code></div>
              </td>
              <td>
                <strong title="<%= row.derivationMeta %>"><%= row.calculationLabel %></strong>
                <span class="admin-question-meta"><%= row.typeLabel %> · <%= row.evidenceLabel %></span>
              </td>
              <td class="admin-question-override">
                <% if (editing) { %>
                  <label class="sr-only" for="question-<%= row.id %>-points">Points for <%= row.prompt %></label>
                  <span class="admin-question-points-current">Current: <code class="admin-question-code" title="<%= row.scoringDetail %>"><%= row.pointsCurrentLabel %></code></span>
                  <% if (row.hasPointsOverride) { %><span class="admin-question-meta">Default: <%= row.pointsDefaultLabel %></span><% } %>
                  <% if (row.pointsFields.length) { %>
                    <div class="admin-question-points-fields" aria-label="Scoring override fields">
                      <% row.pointsFields.forEach((field) => { %>
                        <label>
                          <span><%= field.label %></span>
                          <input id="question-<%= row.id %>-points-<%= field.key %>" type="number" name="<%= row.id %>__points__<%= field.key %>" value="<%= field.value %>" placeholder="<%= field.placeholder %>" step="any" title="Leave blank in every scoring field to use the default">
                        </label>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <input id="question-<%= row.id %>-points" type="<%= row.pointsInputType %>" name="<%= row.id %>__points" value="<%= row.pointsOverride %>" placeholder="<%= row.pointsInputPlaceholder %>" title="Leave blank to use the default: <%= row.scoringDetail %>" <%= row.pointsInputType === 'number' ? 'step="any"' : '' %>>
                  <% } %>
                  <span class="admin-question-meta">Blank = default</span>
                <% } else { %>
                  <code class="admin-question-code" title="<%= row.scoringDetail %>"><%= row.scoringLabel %></code>
                <% } %>
              </td>
              <td class="admin-question-included">
                <% if (editing) { %>
                  <label>
                    <input type="checkbox" name="<%= row.id %>__included" value="1" <%= row.included ? 'checked' : '' %>>
                    <span class="sr-only">Include <%= row.prompt %></span>
                    <span aria-hidden="true"><%= row.included ? 'Yes' : 'No' %></span>
                  </label>
                <% } else { %>
                  <span class="admin-question-included-value"><%= row.included ? 'Yes' : 'No' %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </form>

  <p class="muted admin-question-contract-note">
    Calculation type and source are contract metadata and stay read-only here. Editing wording does not change the stable question ID or existing answers.
  </p>
</div>

<%- include('partials/footer') %>
