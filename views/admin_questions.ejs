<%- include('partials/header', { title: 'Questions', user }) %>
<%- include('partials/admin_nav', { active: 'questions', season }) %>

<% const rows = Array.isArray(questionRows) ? questionRows : []; %>
<% const selectedSeason = Number(season); %>
<% const seasonQuery = `season=${encodeURIComponent(selectedSeason)}`; %>
<% const statusLabels = { none: 'No actual', pending: 'Pending review', reviewed: 'Reviewed', published: 'Published' }; %>
<% const optionLabels = { ready: 'Options ready', unresolved: 'Options unresolved', select_season: 'Select a season', not_applicable: 'No option list' }; %>

<div class="card admin-page-card admin-questions-page">
  <div class="admin-race-data-heading">
    <div>
      <h1>Questions</h1>
      <p class="muted admin-page-intro">
        Review the question contract, catalog readiness, derived actuals, and scoring settings in one place.
      </p>
      <p class="muted admin-question-scope-note">
        <strong>Global settings</strong> · inclusion, scoring overrides, and order apply to every season.
        The selected season only controls catalog readiness and actual links.
      </p>
    </div>
    <div class="admin-race-data-selector-stack">
      <form method="get" action="/admin/questions" class="admin-race-data-selector-form">
        <label for="admin-questions-season">Season</label>
        <select id="admin-questions-season" name="season" onchange="this.form.submit()">
          <% (availableSeasons || []).forEach((availableSeason) => { %>
            <option value="<%= availableSeason.year %>" <%= Number(availableSeason.year) === selectedSeason ? 'selected' : '' %>><%= availableSeason.displayLabel %></option>
          <% }) %>
        </select>
      </form>
    </div>
  </div>

  <% if (seasonContext?.invalidRequestedSeason) { %>
    <div class="admin-feedback-context">
      <div class="alert" role="alert">The selected season is not available.</div>
    </div>
  <% } %>

  <% if (saveError || saveSuccess) { %>
    <div class="admin-feedback-context">
      <% if (saveError) { %><div class="alert" role="alert"><%= saveError %></div><% } %>
      <% if (saveSuccess) { %><p class="muted" role="status"><%= saveSuccess %></p><% } %>
    </div>
  <% } %>

  <div class="admin-question-toolbar" aria-label="Question administration modes">
    <div class="admin-race-data-switch" role="tablist" aria-label="Question view">
      <a class="admin-race-data-tab <%= mode === 'view' ? 'is-active' : '' %>"
         role="tab" aria-selected="<%= mode === 'view' ? 'true' : 'false' %>"
         href="/admin/questions?<%= seasonQuery %>">Questions</a>
      <a class="admin-race-data-tab <%= mode === 'settings' ? 'is-active' : '' %>"
         role="tab" aria-selected="<%= mode === 'settings' ? 'true' : 'false' %>"
         href="/admin/questions?<%= seasonQuery %>&mode=settings">Edit settings</a>
      <a class="admin-race-data-tab <%= mode === 'order' ? 'is-active' : '' %>"
         role="tab" aria-selected="<%= mode === 'order' ? 'true' : 'false' %>"
         href="/admin/questions?<%= seasonQuery %>&mode=order">Edit order</a>
    </div>
    <% if (mode !== 'view') { %>
      <a class="secondary admin-question-cancel" href="/admin/questions?<%= seasonQuery %>">Cancel</a>
    <% } %>
  </div>

  <% if (mode === 'settings') { %>
    <form method="post" action="/admin/questions" class="admin-question-edit-form">
      <%- csrfField() %>
      <input type="hidden" name="season" value="<%= selectedSeason %>">
      <div class="admin-question-table-wrap admin-table-scroll" role="region" aria-label="Question settings table" tabindex="0">
        <table class="table compact admin-question-table admin-question-table--settings">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Question</th>
              <th scope="col">Basis</th>
              <th scope="col">Included</th>
              <th scope="col">Default</th>
              <th scope="col">Override</th>
              <th scope="col">Effective</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach((row) => { %>
              <tr>
                <td class="admin-question-order-number"><%= String(row.number).padStart(2, '0') %></td>
                <td class="admin-question-cell">
                  <div class="admin-question-title" title="<%= row.question.prompt %>"><%= row.shortLabel %></div>
                  <div class="muted admin-question-id"><code class="admin-question-code"><%= row.id %></code></div>
                </td>
                <td>
                  <strong><%= row.basisLabel %></strong>
                  <span class="admin-question-meta"><%= row.typeLabel %></span>
                </td>
                <td class="admin-question-included">
                  <label>
                    <input type="checkbox" name="<%= row.id %>__included" value="1" <%= row.included ? 'checked' : '' %>>
                    <span>Included</span>
                  </label>
                </td>
                <td><code class="admin-question-code" title="<%= row.scoringDetail %>"><%= row.question._basePoints == null ? '—' : JSON.stringify(row.question._basePoints) %></code></td>
                <td class="admin-question-override">
                  <input type="text" name="<%= row.id %>__points" value="<%= row.question._pointsOverrideRaw || '' %>" placeholder="Default">
                </td>
                <td><code class="admin-question-code" title="<%= row.scoringDetail %>"><%= row.scoringLabel %></code></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="admin-question-form-actions">
        <button type="submit">Save settings</button>
        <a class="secondary" href="/admin/questions?<%= seasonQuery %>">Cancel</a>
      </div>
    </form>
  <% } else if (mode === 'order') { %>
    <div class="admin-question-table-wrap admin-table-scroll" role="region" aria-label="Question order table" tabindex="0">
      <table class="table compact admin-question-table admin-question-table--order">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Question</th>
            <th scope="col">Basis</th>
            <th scope="col">Derivation</th>
            <th scope="col">Scoring</th>
            <th scope="col">Move</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((row, index) => { %>
            <tr>
              <td class="admin-question-order-number"><%= String(row.number).padStart(2, '0') %></td>
              <td class="admin-question-cell">
                <div class="admin-question-title" title="<%= row.question.prompt %>"><%= row.shortLabel %></div>
                <div class="muted admin-question-id"><code class="admin-question-code"><%= row.id %></code></div>
              </td>
              <td><strong><%= row.basisLabel %></strong><span class="admin-question-meta"><%= row.typeLabel %></span></td>
              <td><strong><%= row.derivationLabel %></strong><span class="admin-question-meta"><%= row.evidenceLabel %></span></td>
              <td><code class="admin-question-code" title="<%= row.scoringDetail %>"><%= row.scoringLabel %></code></td>
              <td class="admin-order-actions">
                <form method="post" action="/admin/questions/reorder">
                  <%- csrfField() %>
                  <input type="hidden" name="season" value="<%= selectedSeason %>">
                  <button type="submit" class="secondary admin-order-btn" name="move" value="<%= row.id %>:up" <%= index === 0 ? 'disabled' : '' %> aria-label="Move <%= row.shortLabel %> up" title="Move up">&#8593;</button>
                </form>
                <form method="post" action="/admin/questions/reorder">
                  <%- csrfField() %>
                  <input type="hidden" name="season" value="<%= selectedSeason %>">
                  <button type="submit" class="secondary admin-order-btn" name="move" value="<%= row.id %>:down" <%= index === rows.length - 1 ? 'disabled' : '' %> aria-label="Move <%= row.shortLabel %> down" title="Move down">&#8595;</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="admin-question-table-wrap admin-table-scroll" role="region" aria-label="Questions contract table" tabindex="0">
      <table class="table compact admin-question-table admin-question-table--contract">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Question</th>
            <th scope="col">Basis</th>
            <th scope="col">Derivation</th>
            <th scope="col">Scoring</th>
            <th scope="col">Actual</th>
            <th scope="col">Readiness</th>
            <th scope="col">Links</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((row) => { %>
            <tr>
              <td class="admin-question-order-number"><%= String(row.number).padStart(2, '0') %></td>
              <td class="admin-question-cell">
                <div class="admin-question-title" title="<%= row.question.prompt %>"><%= row.shortLabel %></div>
                <div class="muted admin-question-id"><code class="admin-question-code"><%= row.id %></code></div>
              </td>
              <td>
                <strong><%= row.basisLabel %></strong>
                <span class="admin-question-meta"><%= row.typeLabel %></span>
              </td>
              <td>
                <strong><%= row.derivationLabel %></strong>
                <span class="admin-question-meta"><%= row.evidenceLabel %> · <%= row.scopeLabel %></span>
              </td>
              <td><code class="admin-question-code" title="<%= row.scoringDetail %>"><%= row.scoringLabel %></code></td>
              <td>
                <span class="admin-question-status admin-question-status--<%= row.actualStatus %>"><%= statusLabels[row.actualStatus] || statusLabels.none %></span>
                <% if (row.actualRoundNumber) { %><span class="admin-question-meta">R<%= row.actualRoundNumber %></span><% } %>
              </td>
              <td>
                <span class="admin-question-status admin-question-status--<%= row.optionState %>"><%= optionLabels[row.optionState] || row.optionState %></span>
                <% if (row.optionCount != null) { %><span class="admin-question-meta"><%= row.optionCount %> options</span><% } %>
              </td>
              <td class="admin-question-links">
                <% if (row.raceDataHref) { %><a href="<%= row.raceDataHref %>" title="<%= row.derivationLabel %>">Race data · <%= row.derivationLabel %></a><% } %>
                <a href="<%= row.actualsHref %>" title="Open this question in Season Actuals">Actuals</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <p class="muted admin-question-contract-note">
    Definition, type, option source, derivation, and evidence fields are read-only here. Changes to those fields require a versioned question-definition migration.
  </p>
</div>

<%- include('partials/footer') %>
